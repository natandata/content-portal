# URL e chaves do projeto Supabase.
# Pegue em Settings > API Keys, aba "Publishable and secret API keys".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Chave secreta — SOMENTE server-side. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Email do administrador. Resolvido pelo servidor quando alguem entra como "Admin".
ADMIN_EMAIL=admin@contentportal.local

# Senha do primeiro acesso, usada APENAS pelo `npm run seed` (nunca em runtime,
# nao precisa existir na Vercel). Escolha uma senha forte: se a aplicacao estiver
# publica, qualquer um pode tentar entrar como Admin.
ADMIN_INITIAL_PASSWORD=

# Opcional, ferramenta de desenvolvimento: chave do Magic MCP (21st.dev).
# Nao e usada pelo app em runtime — apenas pelo servidor MCP do .mcp.json.
TWENTYFIRST_API_KEY=

# Web Push (notificacoes no navegador/celular). Gere um par novo com:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# A publica tambem vai para o navegador (prefixo NEXT_PUBLIC_); a privada e
# so do servidor e assina cada notificacao — nunca deve vazar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo Web Push, usado pelos provedores (Chrome,
# Firefox...) para falar com voce em caso de abuso. Um mailto: valido basta.
VAPID_SUBJECT=mailto:contato@example.com

# Stripe (pagamento online das cobrancas, via Connect).
# Sem estas variaveis o app sobe normalmente e o pagamento online fica
# desligado — nenhuma tela quebra, o metodo "Pagamento online" apenas nao
# aparece. Pegue a chave secreta em Developers > API keys (use a de TESTE
# enquanto estiver desenvolvendo: comeca com sk_test_).
STRIPE_SECRET_KEY=
# Segredo de assinatura do endpoint de webhook. No painel: Developers >
# Webhooks > o endpoint > "Signing secret" (comeca com whsec_). Rodando local,
# use o valor que o `stripe listen` imprime.
# Cadastre UM unico endpoint com "listen to events on connected accounts"
# ligado: dois endpoints separados geram dois segredos diferentes.
STRIPE_WEBHOOK_SECRET=
# Origem publica do app, sem barra no final. A Stripe exige URL absoluta para
# voltar do cadastro e do checkout. Em producao: https://seu-dominio.
# Local: http://localhost:3000 (ja e o padrao se voce deixar em branco).
NEXT_PUBLIC_APP_URL=

# Segredo do Cron Job (vercel.json) que manda os lembretes diarios de cobranca.
# A Vercel envia esse valor sozinha no header Authorization quando a variavel
# existe no projeto — sem ela configurada, o endpoint de cron recusa toda
# chamada. Gere um valor aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
