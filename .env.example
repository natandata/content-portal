# URL e chave publica do projeto Supabase (expostas ao browser)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — SOMENTE server-side. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Credenciais do primeiro acesso do Admin (usadas apenas pelo seed)
ADMIN_EMAIL=admin@contentportal.local
ADMIN_INITIAL_PASSWORD=dawn

# Opcional, ferramenta de desenvolvimento: chave do Magic MCP (21st.dev).
# Nao e usada pelo app em runtime — apenas pelo servidor MCP do .mcp.json.
TWENTYFIRST_API_KEY=
