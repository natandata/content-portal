{
  "name": "content-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:push": "supabase db push",
    "e2e": "node --env-file=.env.local scripts/e2e.mjs",
    "build:worker": "esbuild worker/jobs/*.ts --bundle --platform=node --format=esm --target=node22 --packages=external --conditions=react-server --outdir=worker/dist --out-extension:.js=.mjs",
    "worker:autentique-reconcile": "node --conditions=react-server worker/dist/autentique-reconcile.mjs",
    "worker:instagram-auto-reports": "node --conditions=react-server worker/dist/instagram-auto-reports.mjs",
    "worker:instagram-publish": "node --conditions=react-server worker/dist/instagram-publish.mjs",
    "worker:invoice-recurrence": "node --conditions=react-server worker/dist/invoice-recurrence.mjs",
    "worker:invoice-reminders": "node --conditions=react-server worker/dist/invoice-reminders.mjs"
  },
  "dependencies": {
    "@composio/core": "^0.18.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "googleapis": "^178.0.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
